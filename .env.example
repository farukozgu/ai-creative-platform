NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
OPENAI_API_KEY=

# Server-only, explicit opt-in. Missing quota RPC/configuration denies all OpenAI I/O.
# UTC daily request counts include upload analysis, validation and repair, even failures.
# These are request ceilings, not dollar quotes or customer credits.
OPENAI_BETA_ENABLED=false
OPENAI_BETA_USER_IDS=
OPENAI_BETA_USER_DAILY_IMAGES=4
OPENAI_BETA_USER_DAILY_ANALYSES=24
OPENAI_BETA_GLOBAL_DAILY_IMAGES=20
OPENAI_BETA_GLOBAL_DAILY_ANALYSES=120

# Image edits remain fail-closed until the image-edit admission migration has
# been independently verified and this server-only gate is explicitly enabled.
IMAGE_EDIT_EXECUTION_ENABLED=false

# Product reanalysis admission is configured only in PostgreSQL after the
# additive migration is independently verified. There is no client-side flag.

# Video remains independently disabled until its existing approval gates open.
VIDEO_GENERATION_ENABLED=false
VIDEO_RECONCILIATION_SCHEDULER_ENABLED=false
VIDEO_RECONCILIATION_CRON_SECRET=

# Shared Video/UGC fal.ai transport credential, server-only. UGC submission is
# code-disabled; setting this key or Video flags cannot enable UGC generation.
FAL_KEY=

# Video Studio: one allowlisted tester, separate from customer credits. Default off.
VIDEO_BETA_ENABLED=false
VIDEO_BETA_USER_IDS=
# One UUID and USD ceiling, set only after explicit approval of that test.
VIDEO_BETA_APPROVED_SUBMISSION_ID=
VIDEO_BETA_APPROVED_MAX_COST_USD=0
VIDEO_BETA_APPROVED_TIER=
VIDEO_BETA_APPROVED_DURATION_SECONDS=

# Product preservation: enable only after the approved target migration exists.
# Local FFmpeg motion still requires the Video beta allowlist; it never uses FAL.
VIDEO_SOURCE_MOTION_ENABLED=false
# Paid analysis additionally requires OpenAI beta access and explicit per-job consent.
VIDEO_FIDELITY_ENABLED=false
