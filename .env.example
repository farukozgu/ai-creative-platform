# Image edits remain fail-closed until the image-edit admission migration has
# been independently verified and this server-only gate is explicitly enabled.
IMAGE_EDIT_EXECUTION_ENABLED=false

# Product reanalysis admission is configured only in PostgreSQL after the
# additive migration is independently verified. There is no client-side flag.

# Video remains independently disabled until its existing approval gates open.
VIDEO_GENERATION_ENABLED=false
VIDEO_RECONCILIATION_SCHEDULER_ENABLED=false
