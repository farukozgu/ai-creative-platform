NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
OPENAI_API_KEY=

# Server-only, explicit opt-in. Missing quota RPC/configuration denies all OpenAI I/O.
# UTC daily request counts include upload analysis, validation and repair, even failures.
# These are request ceilings, not dollar quotes or customer credits.
OPENAI_BETA_ENABLED=false
OPENAI_BETA_USER_IDS=
OPENAI_BETA_USER_DAILY_IMAGES=4
OPENAI_BETA_USER_DAILY_ANALYSES=24
OPENAI_BETA_GLOBAL_DAILY_IMAGES=20
OPENAI_BETA_GLOBAL_DAILY_ANALYSES=120

# Image edits remain fail-closed until the image-edit admission migration has
# been independently verified and this server-only gate is explicitly enabled.
IMAGE_EDIT_EXECUTION_ENABLED=false

# Product reanalysis admission is configured only in PostgreSQL after the
# additive migration is independently verified. There is no client-side flag.

# Video remains independently disabled until its existing approval gates open.
VIDEO_GENERATION_ENABLED=false
VIDEO_RECONCILIATION_SCHEDULER_ENABLED=false
VIDEO_RECONCILIATION_CRON_SECRET=
# Native Vercel GET cron uses this separate platform-managed bearer credential.
# Configure only during an approved deployment; the scheduler flag remains off.
CRON_SECRET=

# Shared Video/UGC fal.ai transport credential, server-only. UGC submission is
# code-disabled; setting this key or Video flags cannot enable UGC generation.
FAL_KEY=

# Video Studio: one allowlisted tester, separate from customer credits. Default off.
VIDEO_BETA_ENABLED=false
VIDEO_BETA_USER_IDS=
# Server-side transaction policy; keep disabled until the additive migration is verified.
VIDEO_BETA_TRANSACTION_APPROVALS_ENABLED=false
VIDEO_BETA_MAX_COST_PER_REQUEST_USD=0
VIDEO_BETA_ALLOWED_TIERS=
VIDEO_BETA_ALLOWED_DURATIONS=

# Normal Video Studio (server/operator only). Does not change the legacy beta policy.
# Apply configure_video_studio_budget migration before enabling spending.
VIDEO_STUDIO_ENABLED=false
VIDEO_STUDIO_ACCESS_MODE=allowlist
VIDEO_STUDIO_USER_IDS=
# Set authenticated explicitly to admit all signed-in users; never use client claims.
VIDEO_STUDIO_SPENDING_ENABLED=false
VIDEO_STUDIO_ALLOWED_TIERS=standard,pro
VIDEO_STUDIO_ALLOWED_DURATIONS=5,10
VIDEO_STUDIO_MAX_COST_PER_REQUEST_USD=2
# Required for a ceiling above $2 or the literal unlimited; DB budgets still apply.
VIDEO_STUDIO_ALLOW_HIGH_LIMITS=false
# Daily user USD/count, daily global USD and lifetime USD are operator-only DB settings
# in video_studio_budget_settings. Defaults: $2 / 3 / $10 / $10.

# Paid analysis additionally requires OpenAI beta access and explicit per-job consent.
VIDEO_FIDELITY_ENABLED=false

# AI Video Director uses existing OpenAI analysis quota and separate per-plan cost consent.
# Off by default; cached/free fallback plans never start inference.
VIDEO_DIRECTOR_ENABLED=false
